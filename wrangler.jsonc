{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "kewkew-cf",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": [
		"nodejs_als"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kewkew-local",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "./migrations"
		},
	],
	"env": {
		"preview": {
			"name": "kewkew-preview",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kewkew-preview",
					"database_id": "c6350d45-7aee-489c-80c6-eea9fa20d610",
					"migrations_dir": "./migrations"
				}
			]
		},
		"production": {
			"name": "kewkew-production",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "kewkew-production",
					"database_id": "508bd6b1-d4c9-41e9-9b96-edc1b063a802",
					"migrations_dir": "./migrations"
				}
			]
		}
	}
}