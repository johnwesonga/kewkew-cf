{
	"name": "kewkew-cf",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"dev:vite": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev --env preview",
		"cf:types": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply kewkew-local --local",
		"db:migrate:preview": "wrangler d1 migrations apply kewkew-preview --env preview --remote",
		"db:migrate:production": "wrangler d1 migrations apply kewkew-production --env production --remote",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"deploy:preview": "npm run build && wrangler deploy --env preview",
		"deploy:production": "npm run build && wrangler deploy --env production",
		"deploy:dry-run": "WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --env= --secrets-file .dev.vars.example --outdir .wrangler/dry-run",
		"deploy": "npm run deploy:production"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/qrcode": "^1.5.6",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"wrangler": "^4.153.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*.svg": "./src/lib/*.svg",
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*": "./src/lib/*.js"
	},
	"dependencies": {
		"better-auth": "^1.7.13",
		"drizzle-orm": "0.45.4",
		"qrcode": "^1.5.4"
	}
}